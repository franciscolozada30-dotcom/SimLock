<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- 📱 Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIM Blocker"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- 📝 Descripción -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bloquea llamadas de números desconocidos que no estén en tus contactos."
        android:textSize="14sp"
        android:layout_marginBottom="24dp"
        android:gravity="center"/>

    <!-- ⚙️ Interruptor General -->
    <Switch
        android:id="@+id/switchBlocker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activar Bloqueo Automático"
        android:layout_marginBottom="16dp"/>

    <!-- 📶 Interruptor SIM 1 -->
    <Switch
        android:id="@+id/switchSim1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bloquear llamadas de SIM 1"
        android:layout_marginBottom="8dp"/>

    <!-- 📶 Interruptor SIM 2 -->
    <Switch
        android:id="@+id/switchSim2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bloquear llamadas de SIM 2"
        android:layout_marginBottom="24dp"/>

    <!-- 🔑 Botón de Permisos -->
    <Button
        android:id="@+id/btnPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CONCEDER PERMISOS Y CONFIGURACIÓN"/>

</LinearLayout>
